{
  "name": "stratawp-advanced-theme",
  "version": "1.0.0",
  "description": "Advanced theme with extended layouts that works with a companion plugin for portfolio, team, testimonial and case-study content, built with StrataWP",
  "author": "Jon Imms",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "ai:setup": "node scripts/ai-setup.mjs",
    "ai:check": "pnpm build && pnpm review",
    "lint:css": "stylelint \"src/**/*.{css,scss}\"",
    "test:e2e": "playwright test --config playwright.smoke.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "review": "stratawp-review"
  },
  "dependencies": {
    "@wordpress/block-editor": "^12.19.0",
    "@wordpress/blocks": "^12.28.0",
    "@wordpress/components": "^27.0.0",
    "@wordpress/data": "^9.17.0",
    "@wordpress/element": "^5.28.0",
    "@wordpress/i18n": "^4.51.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@stratawp/stylelint-config": "workspace:*",
    "@stratawp/theme-review": "workspace:*",
    "@stratawp/testing": "workspace:*",
    "@stratawp/vite-plugin": "workspace:*",
    "@vitejs/plugin-react": "^4.2.1",
    "sass": "^1.94.2",
    "stylelint": "^16.0.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.10"
  }
}
